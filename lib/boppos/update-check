#!/usr/bin/env python3
"""Runs as root via boppos-update-monitor.service; see boppos/update_check.py."""
import sys
from pathlib import Path

for _p in (Path(__file__).resolve().parent / "py", Path("/usr/lib/boppos/py")):
    if (_p / "boppos").is_dir():
        sys.path.insert(0, str(_p))
        break

from boppos.update_check import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
