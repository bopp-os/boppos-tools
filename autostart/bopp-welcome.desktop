[Desktop Entry]
Type=Application
Name=BoppOS Setup
Comment=First-run welcome tour for BoppOS
Exec=/usr/bin/boppos-deck --first-run
Icon=boppos-icon
Categories=System;Settings;
# Does nothing unless /var/lib/boppos/first-run exists; the tour removes it when it finishes
X-GNOME-Autostart-enabled=true
NoDisplay=true
