[Unit]
Description=BoppOS first-run setup (create the first account)
Documentation=https://github.com/bopp-os/boppos-tools
# Runs before the login screen, and only while a first run is pending (the installer's marker) and nobody has a
# real account. oobe-needed (ExecCondition) checks both; a failing check skips the unit, so the login screen
# starts as usual. When the installer already created an account, this never starts: the tour does the rest.
ConditionPathExists=/var/lib/boppos/first-run
ConditionPathExists=/usr/bin/boppos-deck
Before=display-manager.service getty@tty1.service
Conflicts=getty@tty1.service
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service dbus.service
Wants=dbus.service

[Service]
User=boppos-oobe
Group=boppos-oobe
ExecCondition=/usr/libexec/boppos/oobe-needed
# A logind session on tty1 gives the setup its seat: the screen, the keyboard and the controllers.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
Environment=HOME=/var/lib/boppos-oobe
# Same compositor as Gaming Mode; boppos-deck --first-run is the only window (it shows the account setup, because
# oobe-needed just said nobody has an account). Type=oneshot makes the login screen wait until this exits. The loop
# starts the setup again if it quits without finishing (the window was closed, the compositor crashed), because
# without an account nobody could log in; it stops as soon as an account exists.
Type=oneshot
TimeoutStartSec=infinity
ExecStart=/bin/sh -c 'while /usr/libexec/boppos/oobe-needed; do \
  /usr/bin/dbus-run-session -- /usr/bin/gamescope --backend drm -e --force-windows-fullscreen -- /usr/bin/boppos-deck --first-run || sleep 2; \
done'
# No sandboxing on purpose: the setup runs pkexec, and its helper must change /etc, the user database and the
# time zone, which a read-only or private mount namespace would block.

[Install]
WantedBy=graphical.target
