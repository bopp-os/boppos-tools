[Unit]
Description=Install the default BoppOS Flatpaks (Bazaar)
# Once per user: remove the app afterwards and it stays removed.
ConditionPathExists=!%S/boppos-deck/default-flatpaks-done
# Installed for this user only: no password, no admin rights needed.

[Service]
Type=oneshot
ExecStart=/usr/bin/install-optional-flatpaks --defaults --yes
ExecStartPost=/usr/bin/mkdir -p %S/boppos-deck
ExecStartPost=/usr/bin/touch %S/boppos-deck/default-flatpaks-done
# No network yet, or Flathub unreachable: try again later.
Restart=on-failure
RestartSec=300

[Install]
WantedBy=default.target
