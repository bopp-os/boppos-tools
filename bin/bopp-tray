#!/usr/bin/env python3
"""
bopp-tray — BoppOS update notifier tray app.

Runs as a regular user.  Reads the status JSON written by the
boppos-update-monitor.service (root) at /run/boppos/update-status.json,
shows a system-tray icon, and sends desktop notifications when a new
image is available.

Menu
----
  BoppOS is up to date             (status line: up to date / update available / restart needed)
  Restart to Finish Update…        (only when a staged update is waiting for a restart)
  ───────────────
  Open BoppOS Settings             (boppos-deck; also what a left click does)
  ───────────────
  Check for Updates                — triggers an immediate systemd run via polkit
  Install Updates ▸                — runs bopp-system in the background, with notifications
        Everything (system, apps, Homebrew)
        Operating System · Flatpak Apps · Firmware
        Containers (Distrobox & Litterbox)…   — in a terminal
  Review Changes…                  — shows the bopp-diff output in a terminal
  ───────────────
  Last checked: <time>
  Quit

Updates that change the system ask for the administrator password through the desktop's polkit agent.

Dependencies (all available in CachyOS / AUR):
    python-pystray   — cross-DE tray icon (GTK/Qt/AppIndicator backends)
    python-pillow    — icon rendering
    python-gobject   — GObject Introspection bindings (for AppIndicator backend)
    libappindicator  — AppIndicator3 / StatusNotifierItem support (Wayland, Niri, Cinnamon)
    libnotify        — notify-send for desktop notifications
    polkit           — pkexec for privileged one-shot service trigger

Signals
-------
  SIGUSR1 — re-read status file immediately (sent by update-check)
"""

import io
import json
import logging
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

# ── Third-party — fail early with a friendly message ─────────────────────────
try:
    import pystray
    from PIL import Image, ImageDraw
except ImportError as exc:
    sys.exit(
        f"bopp-tray: missing dependency — {exc}\n"
        "Install with: sudo pacman -S python-pystray python-pillow python-gobject libappindicator"
    )

for _p in (Path(__file__).resolve().parent.parent / "lib/boppos/py", Path("/usr/lib/boppos/py")):
    if (_p / "boppos").is_dir():
        sys.path.insert(0, str(_p))
        break

from boppos.tray_logic import compute_state, menu_spec, tooltip  # noqa: E402

# ── Constants ─────────────────────────────────────────────────────────────────
STATUS_FILE = Path("/run/boppos/update-status.json")
POLL_INTERVAL_SECONDS = 300           # 5 min fallback poll
NOTIFY_COOLDOWN_SECONDS = 3600        # don't re-notify for the same digest within 1 h
STATE_FILE = Path(os.path.expanduser("~/.cache/boppos/bopp-tray-state.json"))

ICON_SIZE = 64

# Terminal emulators tried in order when we need to open an interactive window
TERMINALS = [
    "ptyxis",
    "kitty", "alacritty", "foot", "wezterm", "ghostty",
    "konsole", "gnome-terminal", "xterm",
]

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s bopp-tray %(levelname)s: %(message)s",
    datefmt="%H:%M:%S",
)
log = logging.getLogger("bopp-tray")


# ── Icon rendering ────────────────────────────────────────────────────────────

def _is_dark_theme() -> bool:
    """Attempt to detect if the system is using a dark theme via XDG Desktop Portal."""
    try:
        result = subprocess.run(
            [
                "busctl", "--user", "call",
                "org.freedesktop.portal.Desktop",
                "/org/freedesktop/portal/desktop",
                "org.freedesktop.portal.Settings",
                "Read", "ss",
                "org.freedesktop.appearance", "color-scheme"
            ],
            capture_output=True, text=True, timeout=1.0
        )
        if "u 2" in result.stdout:
            return False  # 2 = Prefer light
        elif "u 1" in result.stdout:
            return True   # 1 = Prefer dark
    except Exception:
        pass

    return True  # Default to dark theme if detection fails

def _make_icon(has_update: bool) -> Image.Image:
    """
    Draw or load the tray icon:
      idle    — loads an SVG (boppos-white.svg or boppos-black.svg) based on theme
      update  — orange circle with a white exclamation mark
    """
    cx = ICON_SIZE // 2

    if has_update:
        img = Image.new("RGBA", (ICON_SIZE, ICON_SIZE), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)
        bg = (230, 126, 34, 255)   # orange
        # Background circle
        margin = 4
        draw.ellipse([margin, margin, ICON_SIZE - margin, ICON_SIZE - margin], fill=bg)
        # Exclamation mark
        draw.rectangle([cx - 4, 16, cx + 4, 38], fill="white")
        draw.ellipse([cx - 4, 43, cx + 4, 51], fill="white")
        return img
    else:
        is_dark = _is_dark_theme()
        icon_name = "boppos-white.svg" if is_dark else "boppos-black.svg"
        icon_path = f"/usr/share/icons/hicolor/scalable/apps/{icon_name}"

        try:
            # Pillow doesn't support SVG natively. Rasterize dynamically via librsvg.
            png_data = subprocess.check_output(
                ["rsvg-convert", "-w", str(ICON_SIZE), "-h", str(ICON_SIZE), icon_path],
                stderr=subprocess.DEVNULL
            )
            return Image.open(io.BytesIO(png_data)).convert("RGBA")
        except Exception as e:
            log.warning(f"Failed to load {icon_name}: {e}")
            # Fallback to a simple square if rsvg-convert is missing or the file is absent
            img = Image.new("RGBA", (ICON_SIZE, ICON_SIZE), (0, 0, 0, 0))
            draw = ImageDraw.Draw(img)
            fg = (255, 255, 255, 255) if is_dark else (0, 0, 0, 255)
            draw.rectangle([16, 16, ICON_SIZE - 16, ICON_SIZE - 16], fill=fg)
            return img


# ── State persistence ─────────────────────────────────────────────────────────

def _load_local_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {}


def _save_local_state(state: dict) -> None:
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(json.dumps(state))
    except Exception:
        pass


# ── Status reading ────────────────────────────────────────────────────────────

def read_status() -> dict | None:
    try:
        return json.loads(STATUS_FILE.read_text())
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as exc:
        log.warning("Malformed status file: %s", exc)
        return None


# ── Helpers ───────────────────────────────────────────────────────────────────

def find_terminal() -> str | None:
    for term in TERMINALS:
        if shutil.which(term):
            return term
    return None


def open_in_terminal(cmd: list[str], title: str = "BoppOS") -> None:
    term = find_terminal()
    if term is None:
        _notify("No terminal found", "Install kitty, alacritty, or another terminal.", urgent=True)
        return
    full_cmd: list[str]
    if term in ("ptyxis", "kitty", "alacritty", "foot", "ghostty", "wezterm"):
        full_cmd = [term, "--title", title, "--"] + cmd
    elif term == "konsole":
        full_cmd = ["konsole", "--title", title, "-e"] + cmd
    elif term == "gnome-terminal":
        full_cmd = ["gnome-terminal", "--title", title, "--"] + cmd
    else:
        full_cmd = [term, "-T", title, "-e"] + cmd
    subprocess.Popen(full_cmd)


def _notify(summary: str, body: str = "", urgent: bool = False) -> None:
    cmd = ["notify-send", "--app-name=BoppOS Updater", "--icon=boppos-icon"]
    if urgent:
        cmd += ["--urgency=critical"]
    else:
        cmd += ["--urgency=normal"]
    cmd += [summary, body]
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        log.warning("notify-send not found; install libnotify")


def _trigger_update_check() -> None:
    """Trigger the system service as a one-shot via systemctl (polkit handles auth)."""
    try:
        subprocess.Popen(
            ["systemctl", "start", "boppos-update-monitor.service"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        log.info("Triggered boppos-update-monitor.service")
    except FileNotFoundError:
        _notify("systemctl not found", "systemd is required.", urgent=True)


def launch_detached(cmd: list[str]) -> bool:
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except OSError as exc:
        _notify("Could not start " + cmd[0], str(exc), urgent=True)
        return False


def read_deployment_state() -> dict | None:
    """`bopp-system --json status` (read-only, no password for wheel users). None when unavailable."""
    exe = shutil.which("bopp-system")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "--json", "status"], capture_output=True, text=True, timeout=20)
        data = json.loads(out.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None
    return None if "error" in data else data


def ask_restart() -> None:
    """Notification with a Restart button, so a restart is never one stray click away."""

    def work() -> None:
        try:
            out = subprocess.run(
                ["notify-send", "--app-name=BoppOS Updater", "--icon=boppos-icon", "--wait",
                 "--action=restart=Restart now", "Restart to finish the update",
                 "Save your work first. The update is applied when the system restarts."],
                capture_output=True, text=True, timeout=600)
        except (OSError, subprocess.TimeoutExpired):
            return
        if out.returncode != 0:  # notify-send too old for actions: ask in a terminal instead
            open_in_terminal(["bash", "-c", "read -p 'Restart now to finish the update? [y/N] ' -r r; "
                              "[[ $r =~ ^[Yy]$ ]] && systemctl reboot"], title="BoppOS Restart")
        elif out.stdout.strip() == "restart":
            subprocess.run(["systemctl", "reboot"], check=False)

    threading.Thread(target=work, daemon=True).start()


# ── Tray application ──────────────────────────────────────────────────────────

class BoppTray:
    def __init__(self) -> None:
        self._status: dict | None = None
        self._deploy: dict | None = None
        self._busy = False
        self._local_state = _load_local_state()
        self._lock = threading.Lock()
        self._wakeup = threading.Event()
        self._manual_check_pending = False
        self._handlers = {
            "check": self._on_check_now,
            "review": self._on_view_diff,
            "open-settings": self._on_open_settings,
            "restart": lambda: ask_restart(),
            "update-all": lambda: self._on_update(None, "everything"),
            "update-os": lambda: self._on_update("os", "the operating system"),
            "update-flatpak": lambda: self._on_update("flatpak", "Flatpak apps"),
            "update-firmware": lambda: self._on_update("fw", "firmware"),
            "update-containers": self._on_update_containers,
            "quit": lambda: self._icon.stop(),
        }
        self._icon = pystray.Icon(
            name="bopp-tray",
            icon=_make_icon(False),
            title="BoppOS: checking for updates...",
            menu=self._build_menu(),
        )

    # ── Menu ─────────────────────────────────────────────────────────────────

    def _state(self):
        return compute_state(self._status, self._deploy)

    def _build_menu(self) -> pystray.Menu:
        spec = menu_spec(self._state(), have_settings=bool(shutil.which("boppos-deck")),
                         have_system=bool(shutil.which("bopp-system")), busy=self._busy)
        return pystray.Menu(*self._items(spec))

    def _items(self, spec: list) -> list:
        out = []
        for e in spec:
            if e is None:
                out.append(pystray.Menu.SEPARATOR)
            elif e["children"] is not None:
                out.append(pystray.MenuItem(e["label"], pystray.Menu(*self._items(e["children"])),
                                            enabled=e["enabled"], visible=e["visible"]))
            else:
                action = self._action(e["id"]) if e["id"] in self._handlers else None
                out.append(pystray.MenuItem(e["label"], action, enabled=e["enabled"], visible=e["visible"],
                                            default=e["default"]))
        return out

    def _action(self, item_id: str):
        handler = self._handlers[item_id]
        return lambda _icon, _item: handler()

    def _rebuild_menu(self) -> None:
        self._icon.menu = self._build_menu()
        try:
            self._icon.update_menu()
        except Exception:
            pass

    # ── Callbacks ─────────────────────────────────────────────────────────────

    def _on_open_settings(self) -> None:
        launch_detached(["boppos-deck"])

    def _on_check_now(self) -> None:
        with self._lock:
            self._manual_check_pending = True
        _trigger_update_check()

    def _on_view_diff(self) -> None:
        diff = self._status and self._status.get("diff")
        if diff:
            # Write diff to a temp file, then less it
            import tempfile
            with tempfile.NamedTemporaryFile(
                mode="w", suffix=".txt", prefix="bopp-diff-",
                delete=False
            ) as f:
                f.write(diff)
                tmppath = f.name
            open_in_terminal(["bash", "-c", 'less -R "$1"; rm -f "$1"', "--", tmppath],
                             title="BoppOS — Pending Changes")
        else:
            open_in_terminal(["bopp-diff"], title="BoppOS — Pending Changes")

    def _on_update(self, only: str | None, label: str) -> None:
        """Run bopp-system in the background; notifications report progress and the result."""
        if not shutil.which("bopp-system"):
            open_in_terminal(["bash", "-c", "boppos-update --os --flatpak --brew --verbose; echo; "
                              "read -p 'Press Enter to close...' -r"], title="BoppOS Update")
            return
        with self._lock:
            if self._busy:
                _notify("An update is already running")
                return
            self._busy = True
        self._rebuild_menu()
        _notify(f"Updating {label}…", "You may be asked for your password.")
        threading.Thread(target=self._update_worker, args=(only, label), daemon=True).start()

    def _update_worker(self, only: str | None, label: str) -> None:
        cmd = ["bopp-system", "--json", "upgrade"] + (["--only", only] if only else [])
        final: dict = {}
        tail: list[str] = []
        rc = 1
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in proc.stdout:  # type: ignore[union-attr]
                try:
                    ev = json.loads(line)
                except json.JSONDecodeError:
                    ev = {"event": "log", "line": line.strip()}
                if ev.get("event") == "done":
                    final = ev
                elif ev.get("event") == "log" and ev.get("line"):
                    tail = (tail + [ev["line"]])[-3:]
            rc = proc.wait()
        except OSError as exc:
            tail = [str(exc)]
        finally:
            with self._lock:
                self._busy = False
        ok = rc == 0 and final.get("ok", True)
        if ok and final.get("reboot_required"):
            ask_restart()
        elif ok:
            _notify(f"Updated {label}", "Nothing else to do.")
        else:
            _notify(f"Updating {label} failed", " / ".join(tail) or "See boppos-deck for details.", urgent=True)
        _trigger_update_check()
        self._wakeup.set()

    def _on_update_containers(self) -> None:
        open_in_terminal(
            ["bash", "-c",
             "boppos-update --distrobox --litterbox --verbose; echo; read -p 'Press Enter to close...' -r"],
            title="BoppOS Container Update",
        )

    # ── Core loop ─────────────────────────────────────────────────────────────

    def _refresh(self) -> None:
        """Read the status file and update the icon/menu/notification."""
        new_status = read_status()
        deploy = read_deployment_state()

        with self._lock:
            self._status = new_status
            self._deploy = deploy
            is_manual = self._manual_check_pending
            self._manual_check_pending = False

        state = self._state()
        self._icon.icon = _make_icon(state.needs_attention)
        self._icon.title = tooltip(state)
        self._rebuild_menu()

        if new_status is None:
            if is_manual:
                _notify("Update check failed", "Could not read status file.", urgent=True)
            return

        error: str | None = new_status.get("error")
        staged: str = new_status.get("staged_image") or ""
        if error:
            log.warning("Update check error: %s", error)

        now = time.time()
        if state.kind == "update":
            # Only notify if we haven't already notified for this staged digest
            last_notified = self._local_state.get("last_notified_digest", "")
            last_notified_at = self._local_state.get("last_notified_at", 0)
            if is_manual or staged != last_notified or (now - last_notified_at) > NOTIFY_COOLDOWN_SECONDS:
                _notify(
                    "BoppOS update available!",
                    "A new system image is ready. Open the tray menu and choose Install Updates, "
                    "or open BoppOS Settings.",
                )
                self._local_state["last_notified_digest"] = staged
                self._local_state["last_notified_at"] = now
                _save_local_state(self._local_state)
        elif state.kind == "ok" and is_manual:
            if error:
                _notify("Update check finished", f"Error: {error}")
            else:
                _notify("System is up to date", "No new updates found for BoppOS.")

    def _poll_loop(self) -> None:
        """Background thread: refresh on SIGUSR1 wakeup or POLL_INTERVAL timeout."""
        while True:
            self._wakeup.wait(timeout=POLL_INTERVAL_SECONDS)
            self._wakeup.clear()
            try:
                self._refresh()
            except Exception as exc:
                log.error("Refresh error: %s", exc)

    def _on_sigusr1(self, _signum, _frame) -> None:
        log.info("Received SIGUSR1 — re-reading update status")
        self._wakeup.set()

    def run(self) -> None:
        # Initial read
        self._refresh()

        # Wire SIGUSR1 from the system service
        signal.signal(signal.SIGUSR1, self._on_sigusr1)

        # Background polling thread
        poll_thread = threading.Thread(target=self._poll_loop, daemon=True)
        poll_thread.start()

        log.info("bopp-tray running")
        self._icon.run()
        log.info("bopp-tray exiting")


# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> None:
    # Avoid running multiple instances
    lock_file = STATE_FILE.parent / "bopp-tray.lock"
    try:
        import fcntl
        lf = open(lock_file, "w")
        fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("bopp-tray is already running")
    except Exception:
        pass  # non-fatal if we can't lock

    BoppTray().run()


if __name__ == "__main__":
    main()
