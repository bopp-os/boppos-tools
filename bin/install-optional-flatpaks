#!/bin/bash
# BoppOS Optional Flatpak Installer
# Installs the curated BoppOS Flatpak list

set -euo pipefail

# The installing itself is the Python code boppos-deck uses (per user unless --system; skips what is installed).
run_python() {
    for dir in "$(dirname "$(readlink -f "$0")")/../lib/boppos/py" /usr/lib/boppos/py; do
        if [ -d "$dir/boppos" ]; then
            PYTHONPATH="$dir" python3 -m boppos.flatpaks_cli "$@"
            return
        fi
    done
    echo "[!] Error: boppos Python package not found." >&2
    return 1
}

# Any option selects the non-interactive mode.
if [ $# -gt 0 ]; then
    run_python "$@"
    exit
fi

echo "=========================================="
echo " BoppOS Optional Flatpak Installer"
echo "=========================================="

BOPPOS_LIST="${BOPPOS_FLATPAK_LIST:-/usr/share/boppos/boppos-flatpaks.txt}"
TMP_LIST=$(mktemp /tmp/boppos_flatpaks.XXXXXX)
trap 'rm -f "$TMP_LIST"' EXIT

if [ ! -f "$BOPPOS_LIST" ]; then
    echo "[!] Error: Flatpak list $BOPPOS_LIST not found."
    exit 1
fi

echo "[*] Loading curated Flatpak list..."
# Strip comments (#) and empty lines, then deduplicate and sort
sed 's/#.*//' "$BOPPOS_LIST" | grep -v '^\s*$' | sort -u > "$TMP_LIST" || true

if [ ! -s "$TMP_LIST" ]; then
    echo "[!] Error: Flatpak list $BOPPOS_LIST is empty."
    exit 1
fi

echo "[*] Found $(wc -l < "$TMP_LIST") Flatpaks in the curated list."
read -p "Would you like to review or edit the list before installing? [y/N]: " EDIT_CHOICE

if [[ "$EDIT_CHOICE" =~ ^[Yy]$ ]]; then
    ${EDITOR:-nano} "$TMP_LIST"
fi

if ! grep -q '[^[:space:]]' "$TMP_LIST"; then
    echo "[*] No Flatpaks selected for installation. Exiting."
    exit 0
fi

# As root the apps go to everyone (system); as a normal user they are installed for you only.
SCOPE=()
if [ "$(id -u)" -eq 0 ]; then
    SCOPE=(--system)
fi

echo "[*] Starting installation (this may take a while; apps already installed are skipped)..."
if run_python --list "$TMP_LIST" --yes "${SCOPE[@]}"; then
    echo "[*] All selected Flatpaks are installed."
else
    echo "[!] Some Flatpaks failed to install; see the messages above." >&2
    exit 1
fi
