#!/usr/bin/env python3
"""bopp-performance: battery settings and the sched-ext scheduler for BoppOS."""

import sys
from pathlib import Path

for _p in (Path(__file__).resolve().parent.parent / "lib/boppos/py", Path("/usr/lib/boppos/py")):
    if (_p / "boppos").is_dir():
        sys.path.insert(0, str(_p))
        break

from boppos.performance_cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
