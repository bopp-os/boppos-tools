#!/bin/bash
set -euo pipefail

export LC_ALL=C

JSON_OUTPUT=false
TARGET_INPUT=""
USE_STAGED=false

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --json) JSON_OUTPUT=true; shift ;;
        --staged) USE_STAGED=true; shift ;;
        *) TARGET_INPUT="$1"; shift ;;
    esac
done

log_info() {
    if [ "$JSON_OUTPUT" != true ]; then echo "$1"; fi
}
log_err() {
    echo "$1" >&2
}

if [ "$EUID" -ne 0 ]; then
    log_err "❌ Error: This script must be run as root (e.g., using sudo)."
    exit 1
fi

for cmd in jq cosign pacman vercmp; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        log_err "❌ Error: Required command '$cmd' is not installed."
        exit 1
    fi
done

TMP_DIR=$(mktemp -d /tmp/bopp-diff.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT

log_info "🔍 Gathering current system packages..."
# Get current packages directly from the running host
pacman -Q 2>/dev/null | sort > "$TMP_DIR/current_pkgs.txt"

BOOTED=$(bootc status --json | jq -r '.status.booted.image.image.image // empty')

if [ "$USE_STAGED" = true ]; then
    log_info "Explicitly checking for staged update..."
    STAGED=$(bootc status --json | jq -r '.status.staged.image.image.image // empty')
    if [ -n "$STAGED" ]; then
        TARGET_IMAGE="$STAGED"
        log_info "Found staged update! Target: $TARGET_IMAGE"
    else
        log_err "❌ Error: --staged was requested but no staged update was found by bootc."
        exit 1
    fi
elif [ -z "$TARGET_INPUT" ]; then
    log_info "No target image provided. Checking bootc status..."
    
    # 1. Check if there is an update already staged for the next boot
    STAGED=$(bootc status --json | jq -r '.status.staged.image.image.image // empty')
    
    if [ -n "$STAGED" ]; then
        TARGET_IMAGE="$STAGED"
        log_info "Found staged update! Target: $TARGET_IMAGE"
    else
        # 2. Fallback to checking the remote tracking image for new updates
        if [ -n "$BOOTED" ]; then
            TARGET_IMAGE="$BOOTED"
            log_info "No staged image. Checking upstream tracking image: $TARGET_IMAGE"
        else
            log_err "❌ Error: Could not determine target image from bootc."
            exit 1
        fi
    fi
else
    # Smart input: if it doesn't contain a slash, treat it as a tag for the current base image
    if [[ "$TARGET_INPUT" != *"/"* ]]; then
        if [ -z "$BOOTED" ]; then
            log_err "❌ Error: Could not determine current booted image to append tag."
            exit 1
        fi
        BASE_IMAGE="${BOOTED%%:*}"
        TARGET_IMAGE="${BASE_IMAGE}:${TARGET_INPUT}"
        log_info "Parsed tag input. Target: $TARGET_IMAGE"
    else
        TARGET_IMAGE="$TARGET_INPUT"
        log_info "Using specified image: $TARGET_IMAGE"
    fi
fi

log_info "📥 Downloading package manifest from target image registry via cosign..."
if ! cosign download sbom "$TARGET_IMAGE" > "$TMP_DIR/target_manifest.json" 2>/dev/null; then
    log_err "❌ Error: Failed to download package manifest from GHCR for $TARGET_IMAGE."
    log_err "Ensure the image exists and has an attached manifest."
    exit 1
fi

log_info "📦 Parsing manifest for package differences..."
jq -r '(if type == "array" then .[] elif type == "object" then (if .packages != null and (.packages | type == "array") then .packages[] elif .components != null and (.components | type == "array") then .components[] elif .predicate.packages != null and (.predicate.packages | type == "array") then .predicate.packages[] else . end) else empty end) | .. | objects | select(.name != null and (.name | type == "string") and .packages == null and .components == null) | "\(.name) \(.version // .versionInfo // "")"' "$TMP_DIR/target_manifest.json" | sort > "$TMP_DIR/target_pkgs.txt"

awk '{print $1}' "$TMP_DIR/current_pkgs.txt" | sort > "$TMP_DIR/curr_names.txt"
awk '{print $1}' "$TMP_DIR/target_pkgs.txt" | sort > "$TMP_DIR/tgt_names.txt"

comm -13 "$TMP_DIR/curr_names.txt" "$TMP_DIR/tgt_names.txt" > "$TMP_DIR/added_names.txt"
comm -23 "$TMP_DIR/curr_names.txt" "$TMP_DIR/tgt_names.txt" > "$TMP_DIR/removed_names.txt"
comm -12 "$TMP_DIR/curr_names.txt" "$TMP_DIR/tgt_names.txt" > "$TMP_DIR/common_names.txt"

> "$TMP_DIR/upgraded.txt"
> "$TMP_DIR/downgraded.txt"

join "$TMP_DIR/common_names.txt" "$TMP_DIR/current_pkgs.txt" > "$TMP_DIR/curr_common.txt"
join "$TMP_DIR/common_names.txt" "$TMP_DIR/target_pkgs.txt" > "$TMP_DIR/tgt_common.txt"

join -j 1 "$TMP_DIR/curr_common.txt" "$TMP_DIR/tgt_common.txt" | while read -r pkg curr_ver tgt_ver; do
    if [ "$curr_ver" != "$tgt_ver" ]; then
        cmp=$(vercmp "$tgt_ver" "$curr_ver")
        if [ "$cmp" -gt 0 ]; then
            echo "$pkg $curr_ver $tgt_ver" >> "$TMP_DIR/upgraded.txt"
        else
            echo "$pkg $curr_ver $tgt_ver" >> "$TMP_DIR/downgraded.txt"
        fi
    fi
done

join "$TMP_DIR/added_names.txt" "$TMP_DIR/target_pkgs.txt" > "$TMP_DIR/added.txt"
join "$TMP_DIR/removed_names.txt" "$TMP_DIR/current_pkgs.txt" > "$TMP_DIR/removed.txt"

if [ "$JSON_OUTPUT" = true ]; then
    # Map the text files strictly to JSON arrays using jq
    [ -s "$TMP_DIR/upgraded.txt" ] && jq -R -s 'split("\n")[:-1] | map(split(" ") | {name: .[0], old: .[1], new: .[2]})' "$TMP_DIR/upgraded.txt" > "$TMP_DIR/up.json" || echo "[]" > "$TMP_DIR/up.json"
    [ -s "$TMP_DIR/downgraded.txt" ] && jq -R -s 'split("\n")[:-1] | map(split(" ") | {name: .[0], old: .[1], new: .[2]})' "$TMP_DIR/downgraded.txt" > "$TMP_DIR/down.json" || echo "[]" > "$TMP_DIR/down.json"
    [ -s "$TMP_DIR/added.txt" ] && jq -R -s 'split("\n")[:-1] | map(split(" ") | {name: .[0], version: .[1]})' "$TMP_DIR/added.txt" > "$TMP_DIR/add.json" || echo "[]" > "$TMP_DIR/add.json"
    [ -s "$TMP_DIR/removed.txt" ] && jq -R -s 'split("\n")[:-1] | map(split(" ") | {name: .[0], version: .[1]})' "$TMP_DIR/removed.txt" > "$TMP_DIR/rem.json" || echo "[]" > "$TMP_DIR/rem.json"
    
    jq -n --slurpfile up "$TMP_DIR/up.json" \
          --slurpfile down "$TMP_DIR/down.json" \
          --slurpfile add "$TMP_DIR/add.json" \
          --slurpfile rem "$TMP_DIR/rem.json" \
          '{upgraded: $up[0], downgraded: $down[0], added: $add[0], removed: $rem[0]}'
else
    # Standard terminal format
    echo -e "\n==================================="
    if [ -s "$TMP_DIR/upgraded.txt" ]; then
        echo " 🔼 Upgraded:"
        awk '{print "  "$1": "$2" -> "$3}' "$TMP_DIR/upgraded.txt"
    fi
    if [ -s "$TMP_DIR/downgraded.txt" ]; then
        echo " 🔽 Downgraded:"
        awk '{print "  "$1": "$2" -> "$3}' "$TMP_DIR/downgraded.txt"
    fi
    if [ -s "$TMP_DIR/removed.txt" ]; then
        echo " ❌ Removed:"
        awk '{print "  "$1" "$2}' "$TMP_DIR/removed.txt"
    fi
    if [ -s "$TMP_DIR/added.txt" ]; then
        echo " 📦 Added:"
        awk '{print "  "$1" "$2}' "$TMP_DIR/added.txt"
    fi
    if [ ! -s "$TMP_DIR/upgraded.txt" ] && [ ! -s "$TMP_DIR/downgraded.txt" ] && [ ! -s "$TMP_DIR/removed.txt" ] && [ ! -s "$TMP_DIR/added.txt" ]; then
        echo " ✨ No package changes detected."
    fi
    echo "==================================="
fi
