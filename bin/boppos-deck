#!/usr/bin/env python3
"""boppos-deck: controller-first BoppOS settings (GTK4/libadwaita). Front end for the bopp-* CLIs."""

import sys
from pathlib import Path

for _p in (Path(__file__).resolve().parent.parent / "lib/boppos/py", Path("/usr/lib/boppos/py")):
    if (_p / "boppos").is_dir():
        sys.path.insert(0, str(_p))
        break

from boppos.ui.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
