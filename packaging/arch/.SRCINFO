pkgbase = boppos-tools
	pkgver = 1.1.1
	pkgrel = 1
	url = https://github.com/bopp-os/boppos-tools
	arch = any
	license = GPL3
	makedepends = git
	makedepends = make
	source = boppos-tools-1.1.1.tar.gz::https://github.com/bopp-os/boppos-tools/archive/refs/tags/v1.1.1.tar.gz
	sha256sums = SKIP

pkgname = boppos-tools
	pkgdesc = Custom tools and utilities for BoppOS
	depends = bash
	depends = python
	depends = boppos-artwork
	depends = jq
	depends = cosign
	depends = pacman
	depends = bootc
	depends = python-pystray
	depends = python-pillow
	depends = python-gobject
	depends = libappindicator
	depends = libnotify
	depends = polkit
	depends = ostree
	depends = curl
	depends = flatpak
	depends = skopeo
	depends = fwupd
	depends = distrobox
	depends = podman
	depends = docker
	optdepends = litterbox-sandbox: update Litterbox containers with boppos-update --litterbox
	optdepends = litterbox-sandbox-addons: per-distro Litterbox updates via litterbox-update

pkgname = boppos-artwork
	pkgdesc = Artwork and icons for BoppOS
	depends = hicolor-icon-theme
