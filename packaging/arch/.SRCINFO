pkgbase = boppos-tools
	pkgver = 1.2.0
	pkgrel = 1
	url = https://github.com/bopp-os/boppos-tools
	arch = any
	license = GPL3
	makedepends = git
	makedepends = make
	source = boppos-tools-1.2.0.tar.gz::https://github.com/bopp-os/boppos-tools/archive/refs/tags/v1.2.0.tar.gz
	sha256sums = SKIP

pkgname = boppos-tools
	pkgdesc = Custom tools and utilities for BoppOS (incl. boppos-deck, a controller-friendly settings app)
	depends = bash
	depends = python
	depends = boppos-artwork
	depends = jq
	depends = cosign
	depends = pacman
	depends = bootc
	depends = python-pystray
	depends = python-pillow
	depends = python-gobject
	depends = libappindicator
	depends = libnotify
	depends = polkit
	depends = ostree
	depends = curl
	depends = flatpak
	depends = skopeo
	depends = fwupd
	depends = distrobox
	depends = podman
	depends = docker
	depends = libadwaita
	depends = sdl3
	optdepends = litterbox-sandbox: update Litterbox containers with boppos-update --litterbox
	optdepends = litterbox-sandbox-addons: per-distro Litterbox updates via litterbox-update

pkgname = boppos-artwork
	pkgdesc = Artwork and icons for BoppOS
	depends = hicolor-icon-theme

pkgname = boppos-boot-theme
	pkgdesc = BoppOS boot artwork: Plymouth splash and GRUB theme
	depends = python
	optdepends = plymouth: boot splash (select it with plymouth-set-default-theme boppos)
	optdepends = grub: boot menu theme (put it on /boot with: sudo bopp-grub-theme install)
