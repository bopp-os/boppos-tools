# Maintainer: BoppOS Team
pkgbase=boppos-tools
pkgname=('boppos-tools' 'boppos-artwork' 'boppos-boot-theme')
pkgver=1.2.0
pkgrel=1
arch=('any')
url="https://github.com/bopp-os/boppos-tools"
license=('GPL3')
makedepends=('git' 'make')
source=("${pkgbase}-${pkgver}.tar.gz::https://github.com/bopp-os/boppos-tools/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  # Nothing to build, but required by makepkg
  true
}

package_boppos-tools() {
  pkgdesc="Custom tools and utilities for BoppOS (incl. boppos-deck, a controller-friendly settings app)"
  depends=('bash' 'python' 'boppos-artwork' 'jq' 'cosign' 'pacman' 'bootc' 'python-pystray' 'python-pillow' 'python-gobject' 'libappindicator' 'libnotify' 'polkit' 'ostree' 'curl' 'flatpak' 'skopeo' 'fwupd' 'distrobox' 'podman' 'docker' 'libadwaita' 'sdl3')
  optdepends=('litterbox-sandbox: update Litterbox containers with boppos-update --litterbox'
              'litterbox-sandbox-addons: per-distro Litterbox updates via litterbox-update')

  cd "${srcdir}/${pkgbase}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr SYSCONFDIR=/etc install-tools
}

package_boppos-artwork() {
  pkgdesc="Artwork and icons for BoppOS"
  depends=('hicolor-icon-theme')

  cd "${srcdir}/${pkgbase}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr SYSCONFDIR=/etc install-artwork
}

package_boppos-boot-theme() {
  pkgdesc="BoppOS boot artwork: Plymouth splash and GRUB theme"
  depends=('python')
  optdepends=('plymouth: boot splash (select it with plymouth-set-default-theme boppos)'
              'grub: boot menu theme (put it on /boot with: sudo bopp-grub-theme install)')

  cd "${srcdir}/${pkgbase}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr SYSCONFDIR=/etc install-boot-theme
}
