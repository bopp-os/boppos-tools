// /usr/share/polkit-1/rules.d/51-boppos-deck.rules
//
// boppos-deck runs under gamescope, where no polkit agent exists. The helpers behind these
// actions only run fixed verbs with validated arguments, so the active local wheel user may
// run them without a password. Any other user gets the action's default (auth_admin).

polkit.addRule(function(action, subject) {
    if ((action.id === "org.boppos.deck.kargs" ||
         action.id === "org.boppos.deck.system" ||
         action.id === "org.boppos.deck.decky") &&
        subject.local &&
        subject.active &&
        subject.isInGroup("wheel"))
    {
        return polkit.Result.YES;
    }
});
