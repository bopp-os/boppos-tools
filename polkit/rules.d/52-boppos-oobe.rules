// /usr/share/polkit-1/rules.d/52-boppos-oobe.rules
//
// A first run cannot always type a password: during setup there is no administrator yet. This waives the password
// for:
//
//   - the boppos-oobe account (a no-password system user that only boppos-oobe.service runs as), for the setup,
//     while a first run is pending: the marker /var/lib/boppos/first-run exists, or nobody has a real account yet
//     (oobe-needed says so; a bare `bootc install` has no marker). See docs/first-run.md;
//   - a local, active wheel user, for exactly two command lines of the welcome tour, while the marker exists:
//     choosing where their OWN account starts (set-start-in <their name> gaming|desktop) and finishing the first
//     run (finish-first-run).
//
// oobe-helper checks the same things again (setup verbs only while nobody has an account, set-start-in only for
// the caller's own account), so a rule that is too wide is not the only defence.

var OOBE_HELPER = "/usr/libexec/boppos/oobe-helper";

function markerExists() {
    try {
        polkit.spawn(["/usr/bin/test", "-e", "/var/lib/boppos/first-run"]);
        return true;
    } catch (e) {
        return false;  // test exits 1 when the marker is gone; any other failure also means "do not waive"
    }
}

function setupNeeded() {
    try {
        polkit.spawn(["/usr/libexec/boppos/oobe-needed"]);
        return true;
    } catch (e) {
        return false;  // exits 1 when an account exists
    }
}

polkit.addRule(function(action, subject) {
    if (action.id !== "org.boppos.deck.oobe" || !subject.local || !subject.active) {
        return undefined;
    }
    if (subject.user === "boppos-oobe" && (markerExists() || setupNeeded())) {
        return polkit.Result.YES;
    }
    var own = [
        OOBE_HELPER + " set-start-in " + subject.user + " gaming",
        OOBE_HELPER + " set-start-in " + subject.user + " desktop",
        OOBE_HELPER + " finish-first-run"
    ];
    if (subject.isInGroup("wheel") && own.indexOf(action.lookup("command_line")) !== -1 && markerExists()) {
        return polkit.Result.YES;
    }
    return undefined;
});
