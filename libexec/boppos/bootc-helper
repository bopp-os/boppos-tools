#!/usr/bin/python3 -I
"""Root helper for boppos-deck: fixed bootc/ostree verbs, validated arguments (see privileged.py)."""

import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/boppos/py")

from boppos.privileged import UsageError, system_command  # noqa: E402


def main(argv):
    os.environ.clear()
    os.environ.update(PATH="/usr/sbin:/usr/bin", LANG="C.UTF-8")
    try:
        status = None
        if argv[:1] == ["switch"]:
            status = subprocess.run(
                system_command(["status"]), capture_output=True, text=True, check=True
            ).stdout
        cmd = system_command(argv, status)
    except (UsageError, subprocess.CalledProcessError) as exc:
        print(f"bootc-helper: {exc}", file=sys.stderr)
        return 2
    os.execv(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
