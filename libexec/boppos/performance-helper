#!/usr/bin/python3 -I
"""Root helper for the Performance page: battery settings and the sched-ext scheduler (see privileged.py)."""

import json
import os
import sys
from pathlib import Path

# libexec/boppos/<helper> -> ../../lib/boppos/py: /usr/lib/boppos/py when installed, the repo's lib/ in a checkout
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "lib/boppos/py"))

from boppos.performance import helper_main  # noqa: E402
from boppos.privileged import UsageError, performance_argv  # noqa: E402


def main(argv):
    os.environ.clear()
    os.environ.update(PATH="/usr/sbin:/usr/bin", LANG="C.UTF-8")
    try:
        args = performance_argv(argv)
    except UsageError as exc:
        print(json.dumps({"error": str(exc)}))
        return 2
    return helper_main(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
